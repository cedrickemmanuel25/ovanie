APP_NAME=OVANIE
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.ovanie.com

# L'inscription administrateur doit rester fermée après l'initialisation.
ADMIN_REGISTRATION_ENABLED=false
ADMIN_REGISTER_PASSWORD=

APP_TIMEZONE=Africa/Abidjan
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ovanie
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contact@ovanie.com
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=www.ovanie.com,ovanie.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SMS désactivés tant qu'un fournisseur réel n'est pas configuré.
SMS_ENABLED=false
SMS_DRIVER=none
ALLMYSMS_API_KEY=
ALLMYSMS_SENDER=
ALLMYSMS_API_URL=

# Liens publics des applications OVANIE (laisser vide tant qu'elles ne sont pas publiées)
OVANIE_GOOGLE_PLAY_URL=
OVANIE_APP_STORE_URL=

# Marketplace pricing
MARKETPLACE_DEFAULT_COMMISSION_RATE=0.05
BUSINESS_CONTACT_ACCESS_PRICE=5000

# Homepage promotions
HOMEPAGE_PROMOTION_TIMEZONE=Africa/Abidjan


# PayDunya
PAYDUNYA_ENABLED=false
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=live
PAYDUNYA_CA_BUNDLE=
PAYDUNYA_TEST_MASTER_KEY=
PAYDUNYA_TEST_PRIVATE_KEY=
PAYDUNYA_TEST_PUBLIC_KEY=
PAYDUNYA_TEST_TOKEN=
PAYDUNYA_LIVE_MASTER_KEY=
PAYDUNYA_LIVE_PRIVATE_KEY=
PAYDUNYA_LIVE_PUBLIC_KEY=
PAYDUNYA_LIVE_TOKEN=
PAYDUNYA_WEBHOOK_SECRET=
PAYDUNYA_PAID_STATUSES=completed,success,paid
PAYDUNYA_ALLOW_UNSIGNED_WEBHOOKS_IN_TESTING=false
PAYDUNYA_STORE_NAME=OVANIE
PAYDUNYA_STORE_TAGLINE="Marketplace BTP OVANIE"
PAYDUNYA_STORE_PHONE=0161780000
PAYDUNYA_STORE_ADDRESS="Côte d'Ivoire"
PAYDUNYA_STORE_WEBSITE=https://www.ovanie.com
PAYDUNYA_STORE_LOGO=

# Wave
WAVE_API_URL=
WAVE_SECRET_KEY=
# Ne pas activer le webhook sans une méthode officielle de vérification validée.
WAVE_WEBHOOK_SECRET=


# Programme de fidélité OVANIE
LOYALTY_EARN_EVERY_XOF=1000
LOYALTY_POINT_VALUE_XOF=10
LOYALTY_MAX_REDEMPTION_PERCENT=20

# Espace client OVANIE
RETURN_WINDOW_DAYS=7

# -----------------------------------------------------------------------------
# Cartographie et itinéraires OVANIE Logistics
# -----------------------------------------------------------------------------
MAP_PROVIDER=mapbox
GEOCODING_PROVIDER=mapbox
ROUTING_PROVIDER=tomtom
MAP_DEFAULT_LAT=5.359952
MAP_DEFAULT_LNG=-4.008256
MAP_DEFAULT_ZOOM=12
MAP_COUNTRY_CODE=CI
MAP_COUNTRY_MIN_LAT=4.0
MAP_COUNTRY_MAX_LAT=11.2
MAP_COUNTRY_MIN_LNG=-9.0
MAP_COUNTRY_MAX_LNG=-2.0

MAPBOX_PUBLIC_TOKEN=
MAPBOX_GEOCODING_TOKEN=
MAPBOX_STYLE_URL=mapbox://styles/mapbox/streets-v12
MAPBOX_LANGUAGE=fr
MAPBOX_SEARCH_COUNTRY=CI

TOMTOM_API_KEY=
TOMTOM_ROUTING_BASE_URL=https://api.tomtom.com/routing/1
TOMTOM_TRAFFIC=true

# Itinéraire routier de secours. Il n'est utilisé que si TomTom est indisponible.
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=15
ROUTING_CACHE_MINUTES=10

# Suivi unifié des livraisons
DELIVERY_LOCAL_SIMULATION=false
DELIVERY_CLIENT_POLL_SECONDS=12
DELIVERY_ROUTE_REFRESH_SECONDS=12
DELIVERY_ROUTE_DEVIATION_THRESHOLD_M=30
DELIVERY_ROUTE_DEVIATION_COOLDOWN_SECONDS=8
DELIVERY_ARRIVAL_RADIUS_M=20
DELIVERY_ARRIVAL_MAX_ACCURACY_M=35
DELIVERY_ARRIVAL_CONFIRMATION_FIXES=2
DELIVERY_LOGISTICS_POLL_SECONDS=10
DELIVERY_GPS_ACTIVE_SECONDS=90
DELIVERY_GPS_WEAK_SECONDS=180
DELIVERY_GPS_LOST_SECONDS=300
# Le client ne voit une position que si elle est récente et que la livraison est partie vers lui.
DELIVERY_CLIENT_GPS_MAX_AGE_SECONDS=180
# Empêche le dézoom national et les cartes trop éloignées du trajet opérationnel.
DELIVERY_CLIENT_MAP_MIN_ZOOM=11
DELIVERY_CLIENT_MAP_MAX_SPAN_KM=35

# Protection contre les anciennes données logistiques de démonstration
ALLOW_DEMO_SEEDING=false

# Ne jamais activer en production sans validation métier des résultats
GEO_ALLOW_OPERATIONAL_GEOCODING=false

# Support IA OVANIE
OVANIE_SUPPORT_PHONE="01 61 78 00 00"
OVANIE_SUPPORT_LOCAL_RATE_NOTICE="appel facturé au tarif local"
# Le pipeline conversationnel actuel utilise Anthropic.
SUPPORT_AI_PROVIDER=anthropic
SUPPORT_AI_ENDPOINT=
SUPPORT_AI_API_KEY=
SUPPORT_AI_MODEL=support-local-v1
SUPPORT_AI_TIMEOUT=30

ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_OUTPUT_TOKENS=900
ANTHROPIC_PLANNER_MAX_OUTPUT_TOKENS=550

# OpenAI Responses API — utiliser uniquement côté serveur
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=700
OPENAI_STORE_RESPONSES=false
SUPPORT_AI_RECENT_MESSAGES=12
SUPPORT_AI_MEMORY_TTL_MINUTES=1440
SUPPORT_AI_ENTITY_LIMIT=4
SUPPORT_AI_KNOWLEDGE_LIMIT=5

# Téléphonie Support réelle — Twilio
SUPPORT_TELEPHONY_PROVIDER=none
SUPPORT_TELEPHONY_PUBLIC_BASE_URL=https://support.ovanie.com
SUPPORT_TELEPHONY_FROM_NUMBER=
SUPPORT_TELEPHONY_HUMAN_TRANSFER_NUMBER=
SUPPORT_TELEPHONY_TIMEOUT=20
SUPPORT_TELEPHONY_RECORD_CALLS=false
SUPPORT_TELEPHONY_AUTO_TRANSFER_SENSITIVE=true
SUPPORT_TELEPHONY_VOICE_LANGUAGE=fr-FR
SUPPORT_TELEPHONY_VOICE_NAME=alice
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_ALLOW_UNSIGNED_TESTING=false

# Fournisseur téléphonique webhook générique (facultatif, alternative à Twilio)
SUPPORT_TELEPHONY_OUTBOUND_URL=
SUPPORT_TELEPHONY_API_TOKEN=
SUPPORT_TELEPHONY_WEBHOOK_SECRET=

# WhatsApp Business Platform Cloud API (Meta)
SUPPORT_WHATSAPP_PROVIDER=none
SUPPORT_WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_HTTP_TIMEOUT=20
# Ne jamais activer en production
WHATSAPP_ALLOW_UNSIGNED_TESTING=false
