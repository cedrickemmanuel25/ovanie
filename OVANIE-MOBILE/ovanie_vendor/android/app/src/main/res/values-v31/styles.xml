<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 et plus : l'écran de démarrage du système prend les couleurs OVANIE. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/ovanie_launch_blue</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_empty</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ovanie_launch_blue</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/ovanie_launch_blue</item>
    </style>
</resources>
